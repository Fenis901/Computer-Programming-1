#include <stdio.h>

int main()
{
    int i, j, count, totalPrime = 0;

    for(i = 2; i <= 500; i++)
    {
        count = 0;

        for(j = 1; j <= i; j++)
        {
            if(i % j == 0)
                count++;
        }

        if(count == 2)
            totalPrime++;
    }

    printf("Total Prime Numbers = %d", totalPrime);

    return 0;
}
