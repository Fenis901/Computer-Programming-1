#include <stdio.h>

int main() {
    int i, code;
    int boys = 0, girls = 0;

    for(i = 1; i <= 50; i++) {
        scanf("%d", &code);

        if(code == 1)
            boys++;
        else if(code == 2)
            girls++;
    }

    printf("Boys = %d\n", boys);
    printf("Girls = %d", girls);

    return 0;
}
